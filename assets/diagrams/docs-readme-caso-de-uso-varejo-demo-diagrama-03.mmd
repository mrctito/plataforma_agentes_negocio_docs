flowchart LR
    subgraph Boot["No boot / bootstrap do supervisor"]
        YAML["skills_library<br/>no YAML imutável da release"]
        MAT["Materialização no PostgresStore<br/>/skills/&lt;skill_name&gt;/SKILL.md"]
        YAML -->|"skills selecionadas pelo supervisor"| MAT
    end
    subgraph Prompt["Sempre no prompt (catálogo enxuto)"]
        CAT["name + description<br/>de cada uma das skills declaradas"]
    end
    MAT --> CAT
    subgraph Runtime["Durante a conversa"]
        Q["Pergunta do usuário"]
        DEC{"Alguma description<br/>bate com o pedido?"}
        LOAD["SkillsMiddleware carrega<br/>o SKILL.md completo sob demanda"]
        NOLOAD["Segue sem carregar<br/>skill nenhuma"]
    end
    Q --> DEC
    CAT --> DEC
    DEC -->|"sim"| LOAD
    DEC -->|"não"| NOLOAD
    LOAD --> EXE["Agente segue o procedimento<br/>passo a passo da skill"]
