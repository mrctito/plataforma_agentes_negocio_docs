flowchart TD
    KEY["Uma linha em tenant_access_keys<br/>= uma chave X-API-Key"]

    KEY -->|"coluna tenant_yaml_id<br/>(gerida pela tela 1.2)"| DIRETO["Vínculo DIRETO<br/>aponta para UMA cópia (tenant_yaml)"]
    KEY -->|"colunas saas_project_id + operation<br/>(não gerida por tela hoje)"| PROJETO["Vínculo de PROJETO<br/>aponta para um saas_project + uma operação"]

    DIRETO --> COPIA[("cópia congelada<br/>tenant_yaml")]

